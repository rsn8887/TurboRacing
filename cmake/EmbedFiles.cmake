# Turns binary files into a C++ header with byte arrays (used to embed the fonts in the executable)
function(embed_files OUTPUT)
  set(content "// generated by cmake/EmbedFiles.cmake - do not edit\n#pragma once\n#include <cstddef>\n")
  foreach(path ${ARGN})
    get_filename_component(name ${path} NAME_WE)
    string(REGEX REPLACE "[^A-Za-z0-9]" "_" name ${name})
    file(READ ${path} hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
    string(APPEND content "static const unsigned char embed_${name}[${size}] = {\n${bytes}};\n")
  endforeach()
  file(WRITE ${OUTPUT}.tmp "${content}")
  configure_file(${OUTPUT}.tmp ${OUTPUT} COPYONLY)
endfunction()
